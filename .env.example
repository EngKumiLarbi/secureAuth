APP_NAME=SecuredAuth
APP_ENV=production
APP_DEBUG=false

APP_PEPPER=replace-with-a-long-random-secret
ADMIN_SETUP_TOKEN=replace-with-exactly-32-random-characters

DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=secured_auth
DB_USERNAME=secured_auth_app
DB_PASSWORD=replace-with-mysql-password

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=your-new-gmail-app-password
MAIL_FROM_ADDRESS=your-sender@gmail.com
MAIL_FROM_NAME=SecuredAuth
